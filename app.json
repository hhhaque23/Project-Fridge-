{
  "expo": {
    "name": "FreshScan",
    "slug": "FreshScan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freshscan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freshscan.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FreshScan uses the camera to scan and identify items in your fridge, freezer, and pantry.",
        "NSPhotoLibraryUsageDescription": "FreshScan can import photos of your fridge to identify items.",
        "NSMicrophoneUsageDescription": "FreshScan uses the microphone for voice commands during cooking mode."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "package": "com.freshscan.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FreshScan needs camera access to scan your fridge."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FreshScan can import photos to identify food items."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
